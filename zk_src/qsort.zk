/*
    Quicksort nach dem Lomuto-Partitionsschema
    Wikipedia: https://de.wikipedia.org/wiki/Quicksort
*/


/// Vertauscht die Elemente an den Stellen a und b
op swap(values: [i32], a: u64, b: u64)
{
    sett tmp: i32 = values[a];
    values[a] = values[b];
    values[b] = tmp;
}


/// Teilt values[lo..=hi] am Pivot values[hi] auf und gibt die endgültige Position des Pivots zurück.
/// Danach sind alle Elemente links vom Pivot kleiner und alle rechts größer oder gleich
op partition(values: [i32], lo: i64, hi: i64) -> i64
{
    sett pivot: i32 = values[hi as u64];
    sett store: i64 = lo;

    sling sett i: i64 = lo
    {
        wenn i >= hi {rut};

        wenn values[i as u64] < pivot
        {
            swap(values, store as u64, i as u64);
            store = store + 1;
        };

        i = i + 1;
    };

    swap(values, store as u64, hi as u64);
    store
}


/// Sortiert values[lo..=hi] aufsteigend.
/// Die Grenzen sind i64, da hi bei p = 0 auf -1 fallen kann
op quicksort_range(values: [i32], lo: i64, hi: i64)
{
    wenn lo < hi
    {
        sett p: i64 = partition(values, lo, hi);
        quicksort_range(values, lo, p - 1);
        quicksort_range(values, p + 1, hi);
    };
}


/// Sortiert die ersten len Elemente von values aufsteigend
op quicksort(values: [i32], len: u64)
{
    quicksort_range(values, 0, len as i64 - 1);
}


/// Anzahl der Zeichen, die value als Dezimalzahl braucht (inklusive Minus)
op digit_count(value: i32) -> u64
{
    sett count: u64 = 1;

    wenn value < 0
    {
        count = count + 1;
        value = -value;
    };

    sling
    {
        wenn value < 10 {rut};
        value = value / 10;
        count = count + 1;
    };

    count
}


/// Schreibt value als Dezimalzahl ab der Stelle pos in text und gibt die Stelle direkt dahinter zurück
op write_number(text: string, pos: u64, value: i32) -> u64
{
    sett end: u64 = pos + digit_count(value);

    wenn value < 0
    {
        text[pos] = '-';
        value = -value;
    };

    // Die Ziffern werden von hinten nach vorne geschrieben
    sling sett i: u64 = end
    {
        i = i - 1;
        text[i] = (48 + (value % 10) as u32) as char; // 48 = '0'
        value = value / 10;

        wenn value == 0 {rut};
    };

    end
}


/// Formt die ersten len Elemente von values in einen String der Form "zahl, zahl, zahl" um
op join(values: [i32], len: u64) -> string
{
    wenn len == 0 {geve ""};

    // Zuerst wird die Länge des Strings bestimmt, denn Strings können nicht wachsen
    sett length: u64 = 2 * (len - 1); // ", " zwischen allen Zahlen
    sling sett i: u64 = 0
    {
        wenn i >= len {rut};
        length = length + digit_count(values[i]);
        i = i + 1;
    };

    sett text: string = [length: ' '];
    sett pos: u64 = 0;

    sling sett i: u64 = 0
    {
        wenn i >= len {rut};

        wenn i > 0
        {
            text[pos] = ',';
            pos = pos + 2; // Das Leerzeichen steht durch den default schon da
        };

        pos = write_number(text, pos, values[i]);
        i = i + 1;
    };

    text
}


op main() -> u32
{
    sett values: [i32] = [39, -7, 1024, 0, 5, 42, -128, 5, 9, 1, 100, 3];
    sett len: u64 = 12;

    ice_print(join(values, len));
    quicksort(values, len);
    ice_print(join(values, len));

    0
}
