// Ganze Zeile als Kommentar

/*
    Mehrere Zeilen
    als
    Kommentar
*/

/// Berechnet 0 (hochkomplex)
op null() -> u32 { ((1f - 1f) * 0f) as u32 }

/// Macht einfach garnix
op the_void(doomed: f32) {} 

/// Berechnet 400 auf eine extrem umständliche weise und typecasted alles aus spass...
op main() -> i32
{
    // a = 20
    sett a: u32 = 10 + 5 * 2; // Ende der Zeile als Kommentar

    // Komplett unnötiger Funktionsaufruf
    the_void(a as f32);

    // b = 20**2 = 400
    sett b: i32 = (keenop; sett c: i32 = a as i32) ** 2;

    // b + 0 = b = 400
    b + null() as i32
}
