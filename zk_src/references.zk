op double(value: &u32, times: u32)
{
    sling
    {
        wenn times <= 0 {rut};
        times = times - 1;

        value &= value as u32 * 2;
    }
}


op main() -> u32
{
    sett mysterious_counter: &u32 = &1;
    double(mysterious_counter, 10); // 1024

    sett array1: [bool] = &bool[10: nee];
    sett array2: [bool] = &[ja, nee == ja, nee];

    mysterious_counter
}
